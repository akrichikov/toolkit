{
  "$schema": "./schemas/models.schema.json",
  "_description": "Model provider configurations - SST for all model definitions",
  "default_provider": "bedrock",
  "providers": {
    "bedrock": {
      "enabled": true,
      "models": {
        "claude-sonnet": {
          "model_id": "anthropic.claude-3-5-sonnet-20241022-v2:0",
          "region": "us-east-1",
          "default": true
        },
        "claude-haiku": {
          "model_id": "anthropic.claude-3-haiku-20240307-v1:0",
          "region": "us-east-1"
        },
        "claude-opus": {
          "model_id": "anthropic.claude-3-opus-20240229-v1:0",
          "region": "us-east-1"
        }
      }
    },
    "anthropic": {
      "enabled": true,
      "env_key": "ANTHROPIC_API_KEY",
      "models": {
        "claude-sonnet": {
          "model_id": "claude-sonnet-4-20250514",
          "default": true
        },
        "claude-opus": {
          "model_id": "claude-opus-4-20250514"
        }
      }
    },
    "openai": {
      "enabled": true,
      "env_key": "OPENAI_API_KEY",
      "models": {
        "gpt-4o": {
          "model_id": "gpt-4o",
          "default": true
        },
        "gpt-4o-mini": {
          "model_id": "gpt-4o-mini"
        }
      }
    },
    "ollama": {
      "enabled": true,
      "host": "http://localhost:11434",
      "models": {
        "llama3": {
          "model_id": "llama3.2",
          "default": true
        },
        "codellama": {
          "model_id": "codellama"
        }
      }
    }
  }
}
